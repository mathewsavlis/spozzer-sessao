---
import { aboutData } from "../data/aboutData.js";
import { assetPath } from "../lib/assets.js";

const [primaryImage, secondaryImage] = aboutData.images;
---

<section
  id="sobre"
  class="about-stage"
  data-about-stage
  aria-labelledby="about-title"
>
  <div class="about-container">
    <figure class="about-media" data-about-image>
      <div class="about-media__inner">
        <img
          class="about-image about-image--primary"
          src={assetPath(primaryImage.src)}
          alt={primaryImage.alt}
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
          data-about-photo="primary"
        />

        <img
          class="about-image about-image--secondary"
          src={assetPath(secondaryImage.src)}
          alt=""
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
          data-about-photo="secondary"
        />
      </div>
    </figure>

    <div class="about-content">
      <p class="type-eyebrow about-eyebrow" data-about-item>
        {aboutData.eyebrow}
      </p>

      <h2
        id="about-title"
        class="about-title type-display"
        data-about-item
      >
        {aboutData.title}
      </h2>

      <p class="about-description type-body" data-about-item>
        {aboutData.description}
      </p>
    </div>
  </div>
</section>

<style>
  .about-stage {
    display: grid;
    width: 100%;
    min-height: 100svh;
    align-items: start;
    padding: calc(12svh + var(--safe-top)) var(--page-inline)
      calc(3rem + var(--safe-bottom));
    overflow: hidden;
    background: var(--color-light);
    color: var(--color-dark);
  }

  .about-container {
    display: grid;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    justify-items: center;
    gap: 1.5rem;
  }

  .about-media {
    width: calc(32svh * (4 / 5));
    height: 32svh;
    overflow: hidden;
    border-radius: 2px;
    background: #e4e1dc;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
  }

  .about-media__inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .about-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-image--secondary {
    opacity: 0;
  }

  .about-content {
    display: grid;
    width: 100%;
    max-width: 25rem;
    gap: 0;
  }

  .about-eyebrow {
    margin-bottom: 1.1rem;
    color: var(--color-gold);
    letter-spacing: 0.3em;
  }

  .about-title {
    max-width: 100%;
    color: var(--color-dark);
    font-size: clamp(3.1rem, 12vw, 4.4rem);
    line-height: 0.88;
    white-space: nowrap;
  }

  .about-description {
    width: calc(100% - var(--copy-gutter));
    max-width: 22rem;
    margin-top: 2.1rem;
    color: rgba(42, 42, 42, 0.66);
    font-size: clamp(0.76rem, 2.8vw, 0.87rem);
    line-height: 1.9;
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .about-stage {
      align-items: center;
      padding: var(--page-inline);
    }

    .about-container {
      grid-template-columns: auto minmax(0, 28.125rem);
      align-items: center;
      justify-content: center;
      gap: 6vw;
    }

    .about-media {
      width: calc(60dvh * (4 / 5));
      height: 60dvh;
      max-width: none;
    }

    .about-content {
      max-width: 31rem;
    }

    .about-title {
      font-size: clamp(3.7rem, 4.6vw, 5rem);
    }

    .about-description {
      max-width: 26rem;
      margin-top: 2.35rem;
      font-size: clamp(0.8rem, 0.9vw, 0.92rem);
    }
  }
</style>
